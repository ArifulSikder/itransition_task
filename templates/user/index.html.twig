{% extends 'base.html.twig' %}

{% block title %}Users{% endblock %}

{% block body %}
<div class="card shadow-sm">
    <div class="card-header bg-white py-3">
        <h1 class="h5 mb-0">Users</h1>
    </div>

    <form method="post" action="{{ path('app_users_actions') }}" id="users-form">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('users_toolbar') }}">

        <div class="border-bottom bg-light px-3 py-2">
            <div class="btn-toolbar" role="toolbar" aria-label="User actions">
                <div class="btn-group" role="group" aria-label="Toolbar">
                    <button type="submit" name="action" value="block" class="btn btn-outline-secondary js-needs-selection" disabled data-bs-toggle="tooltip" title="Block selected users">
                        Block
                    </button>
                    <button type="submit" name="action" value="unblock" class="btn btn-outline-secondary js-needs-selection" disabled data-bs-toggle="tooltip" title="Unblock selected users">
                        <i class="bi bi-unlock" aria-hidden="true"></i>
                        <span class="visually-hidden">Unblock</span>
                    </button>
                    <button type="submit" name="action" value="delete" class="btn btn-outline-secondary js-needs-selection" disabled data-bs-toggle="tooltip" title="Delete selected users">
                        <i class="bi bi-trash" aria-hidden="true"></i>
                        <span class="visually-hidden">Delete</span>
                    </button>
                    <button type="submit" name="action" value="delete_unverified" class="btn btn-outline-secondary" data-bs-toggle="tooltip" title="Delete all unverified users">
                        <i class="bi bi-person-x" aria-hidden="true"></i>
                        <span class="visually-hidden">Delete unverified</span>
                    </button>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-center" style="width: 2.5rem;">
                            <input class="form-check-input" type="checkbox" id="select-all" aria-label="Select all" {% if users is empty %}disabled{% endif %}>
                        </th>
                        <th class="text-start">Name</th>
                        <th class="text-start">E-mail</th>
                        <th class="text-end">Last login</th>
                        <th class="text-end">Registered</th>
                        <th class="text-center">Status</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                        <tr>
                            <td class="text-center">
                                <input class="form-check-input js-row-check" type="checkbox" name="ids[]" value="{{ user.id }}" aria-label="Select {{ user.name }}">
                            </td>
                            <td class="text-start">
                                {{ user.name }}
                                {% if currentUser and currentUser.id == user.id %}
                                    <span class="text-muted">(you)</span>
                                {% endif %}
                            </td>
                            <td class="text-start">{{ user.email }}</td>
                            <td class="text-end text-nowrap">
                                {% if user.lastLoginAt %}
                                    {{ user.lastLoginAt|date('Y-m-d H:i') }}
                                {% else %}
                                    <span class="text-muted">Never</span>
                                {% endif %}
                            </td>
                            <td class="text-end text-nowrap">{{ user.registeredAt|date('Y-m-d H:i') }}</td>
                            <td class="text-center">
                                {% if user.status.value == 'active' %}
                                    <span class="badge text-bg-success">active</span>
                                {% elseif user.status.value == 'blocked' %}
                                    <span class="badge text-bg-danger">blocked</span>
                                {% else %}
                                    <span class="badge text-bg-warning">unverified</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">No users found.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </form>
</div>
{% endblock %}
