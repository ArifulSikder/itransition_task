{% extends 'layouts/auth.html.twig' %}

{% block title %}Register{% endblock %}

{% block auth_aside_kicker %}New account{% endblock %}
{% block auth_aside_title %}Create your account{% endblock %}
{% block auth_aside_text %}Register to access the user management table.{% endblock %}

{% block body %}
<p class="text-secondary small mb-1">Create an account</p>
<h1 class="h4 mb-4">Sign up</h1>

{{ form_start(registrationForm) }}
    {{ form_row(registrationForm.name) }}
    {{ form_row(registrationForm.email) }}
    {{ form_row(registrationForm.plainPassword) }}
    <button type="submit" class="btn btn-primary w-100">Sign up</button>
{{ form_end(registrationForm) }}

<p class="text-secondary small mt-4 mb-0">
    Already have an account? <a href="{{ path('app_login') }}">Sign in</a>
</p>
{% endblock %}
